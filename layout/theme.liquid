<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ page_title }} | {{ shop.name }}</title>
  {{ content_for_header }}
  <link rel="stylesheet" href="{{ 'style.css' | asset_url }}">
  <style>
    body { font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif; margin: 0; padding: 0; }
    header { background: #0066FF; color: white; padding: 20px; text-align: center; }
    main { max-width: 1200px; margin: 0 auto; padding: 20px; }
    footer { background: #0A0E27; color: white; padding: 20px; text-align: center; }
  </style>
</head>
<body>
  <header>
    <h1>{{ shop.name }}</h1>
  </header>
  <main>{{ content_for_layout }}</main>
  <footer>
    <p>&copy; {{ shop.name }} 2026</p>
  </footer>
  <script src="{{ 'script.js' | asset_url }}" defer></script>
</body>
</html>
