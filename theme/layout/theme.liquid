<!DOCTYPE html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="theme-color" content="#007bff">
    
    <!-- SEO Meta Tags -->
    <title>{% if page_title != blank %}{{ page_title }} | {% endif %}{{ shop.name }}</title>
    <meta name="description" content="{% if page_description != blank %}{{ page_description | escape }}{% else %}{{ shop.description | escape }}{% endif %}">
    <meta name="keywords" content="electrónica,accesorios,periféricos,Shopify,Colombia">
    <meta name="author" content="{{ shop.name }}">
    
    <!-- Open Graph (Social Media) -->
    <meta property="og:type" content="website">
    <meta property="og:title" content="{% if page_title != blank %}{{ page_title }}{% else %}{{ shop.name }}{% endif %}">
    <meta property="og:description" content="{% if page_description != blank %}{{ page_description | escape }}{% else %}{{ shop.description | escape }}{% endif %}">
    <meta property="og:url" content="{{ canonical_url | escape }}">
    {% if product.featured_image %}
      <meta property="og:image" content="https:{{ product.featured_image | img_url: '1200x630' }}">
    {% endif %}
    <meta property="og:site_name" content="{{ shop.name }}">
    <meta property="og:locale" content="{{ request.locale.iso_code }}">
    
    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content="{% if page_title != blank %}{{ page_title }}{% else %}{{ shop.name }}{% endif %}">
    <meta name="twitter:description" content="{% if page_description != blank %}{{ page_description | escape }}{% else %}{{ shop.description | escape }}{% endif %}">
    
    <!-- Canonical URL -->
    {%- if canonical_url != blank -%}
      <link rel="canonical" href="{{ canonical_url }}">
    {%- endif -%}
    
    <!-- Preload Critical Resources -->
    <link rel="preload" href="{{ 'style.css' | asset_url }}" as="style">
    
    <!-- Stylesheets -->
    <link rel="stylesheet" href="{{ 'style.css' | asset_url }}">
    
    <!-- DNS Prefetch -->
    <link rel="dns-prefetch" href="//cdn.shopify.com">
    <link rel="dns-prefetch" href="//fonts.googleapis.com">
    
    {{ content_for_header }}
  </head>
  
  <body>
    {%- render 'header' -%}
    
    <main role="main" id="main-content">
      {{ content_for_layout }}
    </main>
    
    {%- render 'footer' -%}
    
    <!-- Structured Data - Organization -->
    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "Organization",
      "name": "{{ shop.name }}",
      "url": "{{ shop.url }}",
      "logo": "{% if shop.brand.logo %}https:{{ shop.brand.logo | img_url: '200x' }}{% endif %}",
      "description": "{{ shop.description | escape }}",
      "sameAs": [
        "https://www.facebook.com/innovatecjdsm",
        "https://www.instagram.com/innovatecjdsm"
      ],
      "contactPoint": {
        "@type": "ContactPoint",
        "contactType": "Customer Service",
        "email": "{{ shop.email }}"
      }
    }
    </script>
    
    <script src="{{ 'script.js' | asset_url }}" defer="defer"></script>
  </body>
</html>
